# Get a key at https://developers.jup.ag/portal
JUPITER_API_KEY=
RPC_URL=https://api.mainnet-beta.solana.com
# Path to a Solana CLI keypair JSON file (never commit this)
KEYPAIR_PATH=~/.config/solana/id.json

# Optional buy-and-burn fee (web app only). FEE_BPS of each transaction's guaranteed output buys
# this token and burns it in the same transaction. No fee when users swap into this token.
# Double-check the mint: several copycat tokens share the same name.
BURN_TOKEN_MINT=
FEE_BPS=100
